# Bitcoin Wallet Configuration Template
# Copy this file to .env and update with your settings

# ========================================
# Network Configuration
# ========================================
# Options: regtest, testnet, signet, bitcoin (mainnet - not recommended for testing)
BITCOIN_NETWORK=regtest

# ========================================
# Bitcoin Core RPC Connection
# ========================================
# RPC URL for your Bitcoin Core node
# Default ports:
#   - Mainnet: 8332
#   - Testnet: 18332
#   - Regtest: 18443
#   - Signet:  38332
BITCOIN_RPC_URL=http://127.0.0.1:18443

# RPC credentials (set in your bitcoin.conf or via command line)
BITCOIN_RPC_USER=bitcoinrpc
BITCOIN_RPC_PASSWORD=password

# ========================================
# Wallet Storage
# ========================================
# Directory where wallet data will be stored
# This includes:
#   - wallet.db (SQLite database)
#   - bdk_wallet.db (BDK file store)
WALLET_DIR=./wallet_data

# ========================================
# Notes
# ========================================
# 1. Never commit your actual .env file to version control
# 2. Keep your RPC credentials secure
# 3. For regtest testing, start Bitcoin Core with:
#    bitcoind -regtest -server -rpcuser=bitcoinrpc -rpcpassword=password -fallbackfee=0.00001
# 4. For testnet testing, start Bitcoin Core with:
#    bitcoind -testnet -server -rpcuser=bitcoinrpc -rpcpassword=password
# 5. Make sure the BITCOIN_RPC_URL matches your node's network and port
